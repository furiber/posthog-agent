# Copy to .env and fill in. .env is git-ignored.
# OpenRouter key (model access): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# TypeSafe Jev grader key (validation loop)
TYPESAFE_API_KEY=
# Langfuse v4 tracing (optional; tracing ships only when both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
